# OIDC Configuration Example
# Copy this to .env or set these in your docker-compose.yml

# Required - Your PocketID instance URL
OIDC_ISSUER_URL=https://your-pocketid.example.com

# Required - Your client ID from PocketID
OIDC_CLIENT_ID=your-client-id-here

# Required - Where PocketID redirects after authentication
OIDC_REDIRECT_URI=http://localhost:3000/callback/oidc

# Optional - Customize the login button text
OIDC_BUTTON_TEXT=Sign in with PocketID

# Optional - Set to true to allow HTTP in development (not for production!)
HTTP_ALLOWED=true

# Optional - Set to true to disable traditional email/password login
# OIDC_ONLY=true

# Not needed for public clients (PKCE is used instead)
# OIDC_CLIENT_SECRET=
